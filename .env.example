# 环境变量模板
# 按需复制为 .env.development（本地 npm run dev）或 .env.production（打包 npm run build/dist）后修改
# 注意：禁止修改变量名（VITE_API_BASE_URL / VITE_REQUEST_ENGINE 被 request.ts 与 env.d.ts 读取）

# 后端 API 基础地址（axios baseURL 默认值，创建实例时可覆盖）
VITE_API_BASE_URL=http://localhost:8080

# 请求引擎：ipc = 主进程 Electron net 发起请求（默认，规避 CORS）；xhr = 浏览器 XHR（仅本地调试）
VITE_REQUEST_ENGINE=ipc
