{
  "name": "seller-kit",
  "version": "1.1.0",
  "description": "SellerKit - Template Copy Tool",
  "license": "UNLICENSED",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:minimal": "MODULE_PROFILE=minimal npm run build",
    "build:standard": "MODULE_PROFILE=standard npm run build",
    "build:pro": "MODULE_PROFILE=pro npm run build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --mac --win",
    "dist:minimal": "MODULE_PROFILE=minimal npm run dist",
    "dist:standard": "MODULE_PROFILE=standard npm run dist",
    "dist:pro": "MODULE_PROFILE=pro npm run dist",
    "mail:smoke": "tsc -p tsconfig.electron.json && electron scripts/mail-engine-smoke.cjs",
    "mail:inline:smoke": "tsc -p tsconfig.electron.json && electron scripts/mail-inline-images-smoke.cjs",
    "mail:body:smoke": "tsc -p tsconfig.electron.json && electron scripts/mail-body-protocol-smoke.cjs",
    "ipc:shape:smoke": "tsc -p tsconfig.electron.json && electron scripts/preload-ipc-shape-smoke.cjs",
    "product:smoke": "tsc -p tsconfig.electron.json && electron scripts/product-db-smoke.cjs",
    "shop:smoke": "tsc -p tsconfig.electron.json && electron scripts/shop-db-smoke.cjs",
    "product:sku:smoke": "tsc -p tsconfig.electron.json && electron scripts/product-sku-smoke.cjs",
    "style:smoke": "tsc -p tsconfig.electron.json && electron scripts/style-authority-smoke.cjs",
    "ae:smoke": "tsc -p tsconfig.electron.json && electron scripts/ae-cost-smoke.cjs",
    "ae:settle:smoke": "tsc -p tsconfig.electron.json && electron scripts/ae-settle-smoke.cjs",
    "release": "bash scripts/release.sh",
    "dist:select": "node scripts/select-build.js",
    "build:select": "node scripts/select-build.js --build-only",
    "plugins:demo:install": "node scripts/plugins-install-demo.js",
    "plugins:sandbox:smoke": "node scripts/sandbox-smoke.mjs",
    "plugins:island:smoke": "node scripts/ui-island-smoke.mjs",
    "plugins:create": "node scripts/plugin-create.js",
    "plugins:create:ui": "node scripts/plugin-create.js --ui",
    "rebuild": "node scripts/rebuild-native.js",
    "postinstall": "npm run rebuild",
    "market:serve": "node scripts/serve-market.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "node scripts/check-ipc-contract.mjs",
    "verify:docs": "node scripts/check-doc-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:smoke": "tsc -p tsconfig.electron.json && electron scripts/schema-migration-smoke.cjs",
    "order:smoke": "tsc -p tsconfig.electron.json && electron scripts/order-db-smoke.cjs",
    "picking:smoke": "tsc -p tsconfig.electron.json && electron scripts/picking-db-smoke.cjs",
    "picking:xlsx:smoke": "tsc -p tsconfig.electron.json && electron scripts/picking-xlsx-smoke.cjs",
    "purchase:xlsx:smoke": "tsc -p tsconfig.electron.json && electron scripts/purchase-xlsx-smoke.cjs",
    "ship-rate:smoke": "tsc -p tsconfig.electron.json && electron scripts/ship-rate-db-smoke.cjs",
    "order-profit:ui": "node --check scripts/order-profit-ui-smoke.mjs && node scripts/order-profit-ui-smoke.mjs",
    "picking:ui": "node --check scripts/picking-ui-smoke.mjs && node scripts/picking-ui-smoke.mjs",
    "today:ui": "node --check scripts/today-ui-smoke.mjs && node scripts/today-ui-smoke.mjs",
    "goods:ui": "node --check scripts/goods-ui-smoke.mjs && node scripts/goods-ui-smoke.mjs",
    "shipping-rate:ui": "node --check scripts/shipping-rate-ui-smoke.mjs && node scripts/shipping-rate-ui-smoke.mjs"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "imapflow": "^2.0.2",
    "mailparser": "^3.9.26",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^14.0.0",
    "jszip": "^3.10.1",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "got": "^11.8.6",
    "cacheable-request": "^10.2.12",
    "@electron/rebuild": {
      "node-abi": "^4.35.0"
    }
  }
}
