{
  "name": "seller-kit",
  "version": "1.0.0",
  "description": "SellerKit - Template Copy Tool",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:minimal": "MODULE_PROFILE=minimal npm run build",
    "build:standard": "MODULE_PROFILE=standard npm run build",
    "build:pro": "MODULE_PROFILE=pro npm run build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --mac --win",
    "dist:minimal": "MODULE_PROFILE=minimal npm run dist",
    "dist:standard": "MODULE_PROFILE=standard npm run dist",
    "dist:pro": "MODULE_PROFILE=pro npm run dist",
    "dist:select": "node scripts/select-build.js",
    "build:select": "node scripts/select-build.js --build-only",
    "rebuild": "node scripts/rebuild-native.js",
    "postinstall": "npm run rebuild",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "electron-store": "^8.1.0",
    "exceljs": "^4.4.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vue-tsc": "^2.2.12",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "got": "^11.8.6",
    "cacheable-request": "^10.2.12"
  }
}
