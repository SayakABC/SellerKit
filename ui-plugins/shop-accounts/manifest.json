        "write",
        "writeText"
      ]
    },
    {
      "id": "db",
      "domains": [
        "shop-accounts",
        "shop"
      ],
      "actions": [
        "ensure",
        "list",
        "get",
        "summary",
        "security",
        "upsert",
        "delete",
        "reveal",
        "batchUpdate",
        "companyEnsure",
        "companyList",
        "companyGet",
        "companySummary",
        "companyUpsert",
        "companyDelete",
        "companyProfileUpsert",
        "companyProfileDelete",
        "unmapped",
        "map",
        "unmap"
      ]
    },
    {
      "id": "secrets",
      "domains": [
        "shop-accounts"
      ],
      "actions": [
        "status"
      ]
    },
    {
      "id": "mail",
      "domains": [
        "mail"
      ],
      "actions": [
        "ensure",
        "stats",
        "accountList",
        "accountUpsert",
